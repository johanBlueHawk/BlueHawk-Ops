# ==============================================================================
# BLUE HAWK OPS — CONFIGURACIÓN DE ENTORNO (PRODUCCIÓN / SERVIDOR)
# ==============================================================================

# 1. SERVICIO Y BASE DE DATOS
PROJECT_NAME="Blue Hawk Ops API"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DATABASE_URL="sqlite+aiosqlite:///./blue_hawk_ops.db" # O PostgreSQL: "postgresql+asyncpg://bhops:password@localhost:5432/bhops_db"

# 2. SEGURIDAD Y CIFRADO (SECURITY_GENERAL.md)
SECRET_KEY="generar_un_secreto_aleatorio_de_minimo_32_caracteres"
ENCRYPTION_MASTER_KEY="generar_clave_fernet_aes_de_32_bytes_base64"
ALLOWED_ORIGINS="http://localhost:3000,https://ops.bluehawk.tech"

# 3. CONEXIÓN CON BLUE HAWK INVENTORY
# Opción A (API REST HTTP): Si Inventory corre en el servidor en el puerto 8000 o contenedor Docker
INVENTORY_API_URL="http://localhost:8000/api/v1"
INVENTORY_API_TOKEN="token_de_acceso_si_aplica"

# Opción B (Ruta a Base de Datos SQLite compartida):
# INVENTORY_DB_PATH="/var/www/bluehawk-inventory/backend/bluehawk.db"

# 4. CONEXIÓN CON ZAMMAD HELPDESK & TICKETING
# URL del servidor Zammad (ej. subdominio público o puerto interno en el servidor)
ZAMMAD_HTTP_URL="https://soporte.bluehawk.tech" # O "http://localhost:8080"
# Token de Acceso Personal generado en Zammad (Perfil de Usuario -> Tokens de Acceso -> Crear Token con permiso 'ticket.agent')
ZAMMAD_API_TOKEN="tu_token_de_zammad_aqui"
ZAMMAD_DEFAULT_GROUP="Soporte IT"
ZAMMAD_CUSTOMER_EMAIL="ops-bot@bluehawk.tech"
